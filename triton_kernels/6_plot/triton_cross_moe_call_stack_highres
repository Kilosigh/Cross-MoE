// Triton Kernel Call Stack
digraph {
	dpi=300
	nodesep=0.8 rankdir=TB ranksep=1.5 size="12,16"
	node [fontname="Microsoft YaHei" shape=box style="rounded,filled"]
	edge [fontname="Microsoft YaHei" fontsize=10]
	subgraph cluster_pytorch {
		color=blue fontname="Microsoft YaHei" label="PyTorch 模块与 Autograd 引擎" style=dashed
		nn_module [label="FinalCrossMoEMultiHeadAttention.forward()
(nn.Module)" fillcolor="#E4F0F8"]
		autograd_fwd [label="FinalCrossMoEMultiHeadAttentionFunc.forward()" fillcolor="#E4F0F8"]
		autograd_bwd [label="FinalCrossMoEMultiHeadAttentionFunc.backward()" fillcolor="#E4F0F8"]
		nn_module -> autograd_fwd [label=" 前向传播 (Forward)"]
		nn_module -> autograd_bwd [label=" 反向传播 (Backward)" style=dashed]
	}
	subgraph cluster_forward {
		color=black fontname="Microsoft YaHei" label="前向计算链路 (Forward Operations)" style=dotted
		fwd_wrap_moe [label="triton_moe_project_mha()
(分别处理 Q 和 KV 的专家投影)" fillcolor="#FDF4EF"]
		fwd_wrap_attn [label="batched_flash_decoding_mha()" fillcolor="#FDF4EF"]
		fwd_kernel_moe [label="@triton.jit
batched_expert_project_kernel" fillcolor="#ECFCCB"]
		fwd_kernel_attn_p1 [label="@triton.jit
batched_flash_decoding_mha_phase1" fillcolor="#ECFCCB"]
		fwd_kernel_attn_p2 [label="@triton.jit
batched_flash_decoding_mha_phase2" fillcolor="#ECFCCB"]
		autograd_fwd -> fwd_wrap_moe [label=" 1. 路由与专家投影"]
		autograd_fwd -> fwd_wrap_attn [label=" 2. Flash Decoding 注意力计算"]
		fwd_wrap_moe -> fwd_kernel_moe [label=" 线程网格: (M, B*H, max_blocks)"]
		fwd_wrap_attn -> fwd_kernel_attn_p1 [label=" 线程网格: (max_q_blocks, num_splits, M*B*H)"]
		fwd_wrap_attn -> fwd_kernel_attn_p2 [label=" 线程网格: (max_q_blocks, M*B*H)"]
	}
	subgraph cluster_backward {
		color=black fontname="Microsoft YaHei" label="反向计算链路 (Backward Operations)" style=dotted
		bwd_wrap_attn [label="triton_attention_backward()" fillcolor="#FDF4EF"]
		bwd_wrap_moe [label="triton_moe_project_backward()
(分别计算 dQ 和 dKV 的梯度)" fillcolor="#FDF4EF"]
		bwd_kernel_attn_dq [label="@triton.jit
bwd_kernel_dq_mha" fillcolor="#ECFCCB"]
		bwd_kernel_attn_dkdv [label="@triton.jit
bwd_kernel_dk_dv_mha" fillcolor="#ECFCCB"]
		bwd_kernel_moe [label="@triton.jit
bwd_expert_project_kernel" fillcolor="#ECFCCB"]
		autograd_bwd -> bwd_wrap_attn [label=" 1. 注意力反向传播 (Attention Grad)"]
		autograd_bwd -> bwd_wrap_moe [label=" 2. 专家层反向传播 (MoE Grad)"]
		bwd_wrap_attn -> bwd_kernel_attn_dq [label=" 线程网格: (M, B*H, q_blocks)"]
		bwd_wrap_attn -> bwd_kernel_attn_dkdv [label=" 线程网格: (M, B*H, k_blocks)"]
		bwd_wrap_moe -> bwd_kernel_moe [label=" 线程网格: (M, B*H)"]
	}
}
